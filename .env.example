# Copy to .env.local (never committed) to enable the team test account.
# The test account signs in through the normal login form and can switch between every role.
VITE_TEST_ACCOUNT_EMAIL=you@example.com
# SHA-256 hex of "usr-test:<password>", e.g.
#   node -e "console.log(require('crypto').createHash('sha256').update('usr-test:' + process.argv[1]).digest('hex'))" "<password>"
VITE_TEST_ACCOUNT_PASSWORD_SHA256=
